{
  "name": "Nextjs Template",
  "version": "0.1.0",
  "private": true,
  "output": "dist",
  "scripts": {
    "clean": "if exist .next rmdir /s /q .next",
    "free:3001": "npx --yes kill-port 3001",
    "dev": "set BUILD_MODE= && next dev --port 3001 --hostname 0.0.0.0",
    "dev:reset": "npm run clean && npm run dev",
    "dev:open": "npm run free:3001 && npm run dev",
    "build": "set BUILD_MODE= && next build",
    "build:export": "set BUILD_MODE=export && next build",
    "start": "set BUILD_MODE= && next start --port 3001 --hostname 0.0.0.0",
    "lint": "next lint"
  },
  "dependencies": {
    "@douyinfe/semi-foundation": "^2.38.2",
    "@douyinfe/semi-ui": "^2.38.2",
    "@lark-base-open/js-sdk": "^0.3.2",
    "mysql2": "^3.19.1",
    "next": "^13.4.9",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "reset-css": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "20.4.0",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "eslint": "^8.44.0",
    "eslint-config-next": "^13.4.9",
    "typescript": "^5.1.6"
  }
}
